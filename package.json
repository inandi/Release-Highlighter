{
    "name": "@inandi/release-highlighter",
    "version": "1.1.7",
    "description": "Simple release-journey / product-tour plugin for the web. Define steps in a JSON manifest, theme, and hooks included.",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/types/index.d.ts",
    "unpkg": "dist/release-highlighter.iife.js",
    "jsdelivr": "dist/release-highlighter.iife.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./style.css": "./dist/style.css",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "scripts": {
        "clean": "rm -rf dist",
        "build:esm": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.mjs --target=es2018 --loader:.css=text",
        "build:cjs": "esbuild src/index.ts --bundle --format=cjs --outfile=dist/index.cjs --target=es2018 --loader:.css=text",
        "build:iife": "esbuild src/index.ts --bundle --format=iife --global-name=ReleaseHighlighter --outfile=dist/release-highlighter.iife.js --target=es2018 --minify --loader:.css=text --footer:js=window.ReleaseHighlighter=window.ReleaseHighlighter.default;",
        "build:css": "cp src/style.css dist/style.css",
        "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap false --outDir dist/types",
        "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:iife && npm run build:css && npm run build:types",
        "dev": "npx --yes http-server . -p 5174 -c-1",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "release",
        "highlight",
        "onboarding",
        "product-tour",
        "walkthrough",
        "changelog",
        "whats-new",
        "user-flow"
    ],
    "author": "Gobinda Nandi <gobinda.nandi.public@gmail.com>",
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/inandi/release-highlighter.git"
    },
    "devDependencies": {
        "esbuild": "^0.23.0",
        "typescript": "^5.6.3"
    }
}
